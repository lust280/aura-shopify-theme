<section class="hero" aria-label="{{ section.settings.accessibility_label | default: shop.name | escape }}">
  <div class="hero__media hero__media--desktop">
    {%- if section.settings.desktop_video != blank -%}
      {{ section.settings.desktop_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hero__video' }}
    {%- elsif section.settings.desktop_image != blank -%}
      {{ section.settings.desktop_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.desktop_image.alt }}
    {%- endif -%}
  </div>
  <div class="hero__media hero__media--mobile">
    {%- if section.settings.mobile_video != blank -%}
      {{ section.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hero__video' }}
    {%- elsif section.settings.mobile_image != blank -%}
      {{ section.settings.mobile_image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.mobile_image.alt }}
    {%- elsif section.settings.desktop_video != blank -%}
      {{ section.settings.desktop_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hero__video' }}
    {%- elsif section.settings.desktop_image != blank -%}
      {{ section.settings.desktop_image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.desktop_image.alt }}
    {%- endif -%}
  </div>
  <div class="hero__overlay" style="--hero-overlay: {{ section.settings.overlay_color }}; --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="hero__content hero__content--{{ section.settings.text_alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          {%- if block.settings.text != blank -%}<p class="hero__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>{%- endif -%}
        {%- when 'heading' -%}
          {%- if block.settings.text != blank -%}<h1 class="hero__title" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h1>{%- endif -%}
        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}<div class="hero__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{%- endif -%}
        {%- when 'button' -%}
          {%- if block.settings.label != blank and block.settings.link != blank -%}
            <div class="hero__buttons" {{ block.shopify_attributes }}>
              <a class="button{% if block.settings.style == 'secondary' %} button--secondary{% endif %}" href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Aura hero",
  "tag": "section",
  "class": "aura-hero-section",
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Featured collection" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "video", "id": "desktop_video", "label": "Desktop video" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "video", "id": "mobile_video", "label": "Mobile video" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#24221F" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Aura collection" } ] },
    { "type": "heading", "name": "Heading", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Heading", "default": "Made to feel like you." } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thoughtful essentials, made for everyday rituals.</p>" } ] },
    { "type": "button", "name": "Button", "limit": 2, "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Shop the collection" }, { "type": "url", "id": "link", "label": "Link" }, { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" } ], "default": "primary" } ] }
  ],
  "presets": [
    { "name": "Aura hero", "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ] }
  ]
}
{% endschema %}
